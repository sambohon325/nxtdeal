# Python
backend/venv/
backend/__pycache__/
backend/*.pyc
**/__pycache__/

# Environment
backend/.env

# Runtime storage and operational data must not be committed.
backend/storage/*.json
backend/data/*.csv
backend/data/**/*.csv
backend/storage/*.bak*

# Per-tenant storage — each dealer gets its own
# provisioned dealer gets its own graph.json/credentials.json/audit.json under
# backend/storage/tenants/{dealer_id}/, same real PII/password-hash sensitivity as the
# root storage/ files above.
backend/storage/tenants/

# Point-in-time graph backups (core/data_backup.py's real backup/restore action) — same
# real PII sensitivity as the live graph.json itself.
backend/storage/backups/

# Chat file attachments (photos, scanned forms),
# same "don't track operational/PII data" reasoning as storage/*.json above.
backend/storage/uploads/

# Stray test output (pytest outputs, console logs)
backend/pytest-output/
backend/pytest.out
pytest.out

# Root-level storage created by local runs.
storage/*.json
storage/*.bak*

# Worker tokens — SHA-256 hashes of schedule worker tokens (desktop/mac/vps).
# These are generated by core/schedule_auth.py and must never be committed.
backend/schedule_worker_tokens.json
backend/storage/schedule_worker_tokens.json
storage/schedule_worker_tokens.json

# Next.js
frontend/.next/
frontend/node_modules/

# OS
.DS_Store
Thumbs.db

# Archive
dealeros-ui/
# scratch/junk the cloud bridge could not delete (safe to remove on Windows)
_to_delete/
