{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "lib/deals.ts",
    "lib/assetManagement.ts",
    "lib/repairOrders.ts",
    "components/DealDeskBoard.tsx",
    "components/AssetManagementBoard.tsx",
    "components/RepairOrderWorkspaceBoard.tsx",
    "lib/api.ts",
    "lib/auth.ts",
    "lib/socialReputation.ts",
    "lib/useVisualizationWorkspace.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
