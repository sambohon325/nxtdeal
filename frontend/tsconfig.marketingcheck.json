{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "components/marketing/MarketingChrome.tsx",
    "components/BrandAngles.tsx",
    "components/Icons.tsx",
    "app/page.tsx",
    "app/industries/page.tsx",
    "app/solutions/page.tsx",
    "app/dealeros-network/page.tsx",
    "app/ai-demo/page.tsx",
    "app/company/page.tsx",
    "app/contact/page.tsx",
    "middleware.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
