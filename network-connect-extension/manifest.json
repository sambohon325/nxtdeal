{
  "manifest_version": 3,
  "name": "DealerOS Network Connect",
  "short_name": "Network Connect",
  "version": "1.0.0",
  "description": "Free AI-powered dealer performance intelligence -- benchmark against the DealerOS Network, spot your biggest opportunities, and get a daily AI brief. No cost, no CRM required.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DealerOS Network Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.nxtdeal.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
